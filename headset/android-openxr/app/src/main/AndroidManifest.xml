<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
 <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1"/>
 <application android:label="QuestBridge Diagnostics" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
  <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape">
   <intent-filter>
    <action android:name="android.intent.action.MAIN"/>
    <category android:name="android.intent.category.LAUNCHER"/>
   </intent-filter>
  </activity>
  <meta-data android:name="com.oculus.supportedDevices" android:value="quest2"/>
  <activity android:name=".ClientActivity" android:exported="false" android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
   android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
   android:screenOrientation="landscape">
   <meta-data android:name="android.app.lib_name" android:value="questbridge_client"/>
   <intent-filter>
    <action android:name="android.intent.action.MAIN"/>
    <category android:name="com.oculus.intent.category.VR"/>
   </intent-filter>
  </activity>
 </application>
</manifest>
