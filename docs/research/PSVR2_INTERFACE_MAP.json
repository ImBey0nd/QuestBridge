    {
      "module": "libSceVideoOut",
      "role": "VR output port, buffers and flips",
      "entry_points": [
        "sceVideoOutOpen",
        "sceVideoOutRegisterBuffers2",
        "sceVideoOutConfigureOutput",
        "sceVideoOutSubmitFlip"
      ],
      "contract_status": "PS5VR submits its own buffers; no access to another native game's buffers established"
    },
    {
      "module": "libSceVrHand",
      "role": "Opt-in hand tracking",
      "entry_points": [
        "sceVrHandInitialize",
        "sceVrHandStart",
